
@model SistemaGestionEstudiantes.Models.Estudiante

@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Eliminar estudiante</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                ¿Estás seguro de que deseas eliminar este estudiante?
            </h5>

            <p class="text-muted">
                Esta acción no se puede deshacer.
            </p>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Nombre:</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Apellido:</dt>
                <dd class="col-sm-9">@Model.Apellido</dd>

                <dt class="col-sm-3">Matrícula:</dt>
                <dd class="col-sm-9">@Model.Matricula</dd>

                <dt class="col-sm-3">Carrera:</dt>
                <dd class="col-sm-9">@Model.Carrera</dd>

                <dt class="col-sm-3">Correo:</dt>
                <dd class="col-sm-9">@Model.Correo</dd>

                <dt class="col-sm-3">Teléfono:</dt>
                <dd class="col-sm-9">@Model.Telefono</dd>
            </dl>

            <form asp-action="Eliminar" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Sí, eliminar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </form>

        </div>
    </div>
</div>
